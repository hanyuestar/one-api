# ============================================================
# one-api 环境变量配置模板
# 使用方法：
#   1. cp .env.example .env
#   2. 编辑 .env 修改【必改】项（生产环境必须）
#   3. docker compose up -d
# 说明：.env 文件不会提交到 git（已在 .gitignore），敏感信息仅本地保存
# ============================================================

# ------------------------------------------------------------------
# 镜像配置（一般无需修改）
# ------------------------------------------------------------------
# 镜像仓库地址
#   格式: [registry/]namespace/repo
#   示例: ghcr.io/hanyuestar/one-api
#   示例: docker.io/kyson666/one-api
IMAGE=ghcr.io/hanyuestar/one-api

# 镜像标签
#   格式: 语义化版本或 latest
#   示例: v1.0.0
#   示例: latest
TAG=latest

# Docker Registry 前缀（docker-compose 中用于 redis/mysql 镜像）
#   格式: registry域名 或 docker.io
#   示例: docker.io
REGISTRY=docker.io


# ------------------------------------------------------------------
# 【必改】数据库配置（使用 MySQL 时必须修改）
# ------------------------------------------------------------------
# MySQL Root 密码
#   格式: 强密码（建议 16+ 字符，含大小写数字特殊符号）
#   生成: openssl rand -base64 24
#   示例: K8s9fJ3nL2pQ7vX1zA4bC6dE8fG0hI2j
MYSQL_ROOT_PASSWORD=your_strong_root_password_here

# 业务数据库用户名（一般保持 oneapi）
MYSQL_USER=oneapi

# 业务数据库密码
#   格式: 强密码，建议与 Root 密码不同
#   生成: openssl rand -base64 24
#   示例: mY4sTr0ngP@ssw0rd_F0r_0n3Ap1
MYSQL_PASSWORD=your_strong_user_password_here

# 业务数据库名（一般保持 one-api）
MYSQL_DATABASE=one-api

# 数据库连接串 (DSN) —— one-api 核心配置
#   格式: 用户名:密码@tcp(主机:端口)/数据库名?参数
#   来源: 以上 MYSQL_* 变量组合而成
#   示例: oneapi:mY4sTr0ngP@ssw0rd_F0r_0n3Ap1@tcp(db:3306)/one-api?charset=utf8mb4&parseTime=True&loc=Local
#   说明:
#     - 使用 SQLite 时：注释掉此行（容器自动在 /data/one-api.db 创建文件数据库）
#     - 主机名 db 对应 docker-compose 中的数据库服务名
#     - 如使用外部数据库，改为对应的 IP/域名
SQL_DSN=oneapi:your_strong_user_password_here@tcp(db:3306)/one-api?charset=utf8mb4&parseTime=True&loc=Local


# ------------------------------------------------------------------
# Redis 配置
# ------------------------------------------------------------------
# Redis 连接串
#   格式: redis://[:密码@]主机:端口[/数据库编号]
#   来源: Redis 服务地址
#   示例 (无密码): redis://redis:6379/0
#   示例 (有密码): redis://:your_redis_password@redis:6379/0
#   说明:
#     - 主机名 redis 对应 docker-compose 中的 redis 服务名
#     - 如启用了 redis 密码（redis 命令行 --requirepass），需在连接串中包含密码
REDIS_CONN_STRING=redis://redis:6379/0


# ------------------------------------------------------------------
# 【必改】应用核心配置
# ------------------------------------------------------------------
# Session 加密密钥（必须修改！泄露会导致用户会话被伪造）
#   格式: 32+ 字节的随机 Base64 字符串
#   生成方式:
#     Linux/Mac:  openssl rand -base64 32
#     Windows:    powershell -c "[Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))"
#   示例: k8s9fJ3nL2pQ7vX1zA4bC6dE8fG0hI2jK4lM6nO8pQ=
SESSION_SECRET=your_32_byte_base64_random_string_here

# 时区
#   格式: IANA 时区标识符
#   常用: Asia/Shanghai, America/New_York, UTC, Europe/London
TZ=Asia/Shanghai


# ------------------------------------------------------------------
# 【可选】多机集群部署参数（单机部署忽略）
# ------------------------------------------------------------------
# 节点角色: master(默认) / slave
# 来源: 集群架构设计决定
# 示例: slave
# NODE_TYPE=slave

# 从节点同步频率(秒)
# 格式: 正整数，建议 30-300
# 示例: 60
# SYNC_FREQUENCY=60

# 前端访问基础 URL（从节点必填）
# 格式: 完整 URL，含协议、域名、端口，无尾斜杠
# 来源: 你的反向代理/域名配置
# 示例: https://api.yourdomain.com
# 示例: http://192.168.1.100:3000
# FRONTEND_BASE_URL=https://api.yourdomain.com


# ------------------------------------------------------------------
# 【可选】其他常用参数（按需取消注释）
# ------------------------------------------------------------------
# 日志级别: debug / info / warn / error
# LOG_LEVEL=info

# 启用 pprof 性能分析端口 (默认 6060，仅内网调试用)
# ENABLE_PPROF=true

# 自定义上传文件大小限制 (MB)
# MAX_UPLOAD_SIZE=20